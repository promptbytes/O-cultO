# Your domain, already pointing at this server.
DOMAIN=chat.example.org

# Voice call helpers. Leave as [] to use none (calls then work only when the
# two networks allow a direct connection). With the coturn profile running:
# ICE_SERVERS=[{"urls":["stun:chat.example.org:3478","turn:chat.example.org:3478"],"username":"oculto","credential":"CHANGE-ME"}]
ICE_SERVERS=[]
TURN_USER=oculto
TURN_PASSWORD=CHANGE-ME
